<comment>
problem   = Idealized galaxy precipitator (Athena++) 
configure = --prob=precipitator --coord=spherical_polar -b

<job>
problem_id = precipitator

<output1>
file_type  = hst
dcycle	   = 1

<output2>
file_type  = hdf5
data_format = float32
variable   = prim,divB,tcool_myr,delta_rho_over_rho_bar,temperature_K
cartesian_vector = true
dcycle	   = 100
id         = prim

<output3>
file_type   = rst
ghost_zones = true
id          = restart
dcycle	    = 10000

<time>
cfl_number = 0.2
nlim       = 500000
tlim       = 1.0e3
integrator = rk2
xorder 	   = 3c
ncycle_out = 1

<mesh>
nx1    = 32
x1min  = 1.0
x1max  = 100.0
ix1_bc = reflecting
ox1_bc = reflecting

nx2    = 32
x2min  = 0.0
x2max  = 3.141592653589793
ix2_bc = polar
ox2_bc = polar
x2rat = -1.0	# use wider theta-spacing near poles to alleviate timestep

nx3    = 32
x3min  = 0.0
x3max  = 6.2831853071795862
ix3_bc = periodic
ox3_bc = periodic

<meshblock>
nx1 = 16
nx2 = 16
nx3 = 16

<hydro>
gamma = 1.6666666666666667
pfloor = 1000.0
dfloor = 1454.4065594167007     # Msun kpc^(-3) == 1e-4 cm^{-3}

<units>
unit_system = custom
mass_cgs    = 1.98841586e+33
length_cgs  = 3.086e21
time_cgs    = 3.15576e+13

<precipitator>
hse_profile_filename = inputs/hse_3.0.txt
uniform_init = 0
force_free_param_file = inputs/force_free_params.txt
inner_sponge_tau      = 5.0	# Myr
inner_sponge_radius   = 10.0  	# kpc

enable_powerlaw_cooling = 1
powerlaw_lambda_cgs = 1e-22

enable_fourier_bessel_perturbations = 1
perturbation_sigma = 0.01
perturbation_lmax = 12
perturbation_radial_modes = 16
perturbation_kmin = 1.0		# box size
perturbation_kmax = 16.0	# Nyquist limited: <mesh/nx1> // 2
perturbation_seed = 88172645463393265

enable_heating = magic
thermostat_temperature = 1.0e7
thermostat_Kp = 10.0
h_smooth_heatcool = 10.0
