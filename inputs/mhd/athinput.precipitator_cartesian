<comment>
problem   = Idealized galaxy precipitator (Athena++, Cartesian)
configure = --prob=precipitator --coord=cartesian -b

<job>
problem_id = precipitator_cartesian

<output1>
file_type  = hst
dcycle     = 1000

<output2>
file_type  = vtk
variable   = prim,divB,grav_phi,pressure_hse,temperature_K,entropy_K,delta_rho_over_rho_bar
dt         = 100
id         = prim

<output3>
file_type   = rst
ghost_zones = true
id          = restart
dcycle      = 10000

<time>
cfl_number = 0.25
nlim       = 500000
tlim       = 1.0e4
integrator = rk2
xorder     = 2mc
ncycle_out = 1

<mesh>
# Half-width 120 kpc keeps the cube-corner radius close to the 200 kpc spherical run.
nx1    = 64
x1min  = -120.0
x1max  = 120.0
ix1_bc = outflow
ox1_bc = outflow

nx2    = 64
x2min  = -120.0
x2max  = 120.0
ix2_bc = outflow
ox2_bc = outflow

nx3    = 64
x3min  = -120.0
x3max  = 120.0
ix3_bc = outflow
ox3_bc = outflow

<meshblock>
nx1 = 16
nx2 = 16
nx3 = 16

<hydro>
gamma = 1.6666666666666667
pfloor = 1000.0
dfloor = 1454.4065594167007     # Msun kpc^(-3) == 1e-4 cm^{-3}

<units>
unit_system = custom
mass_cgs    = 1.98841586e+33
length_cgs  = 3.086e21
time_cgs    = 3.15576e+13

<precipitator>
hse_profile_filename = inputs/hse_3.0.txt
uniform_init = 0
force_free_param_file = inputs/force_free_params.txt
# force_free_bfield_gauss rescales the analytic force-free field when set > 0.
force_free_bfield_gauss = 0.
inner_sponge_tau      = 5.0
inner_sponge_radius   = 10.0
outer_sponge_inner_radius = 100.0
outer_sponge_tau      = 5.0
enable_outer_buffer_halo = 1
outer_buffer_inner_radius = 100.0
outer_buffer_entropy_slope = 0.0

enable_powerlaw_cooling = 1
powerlaw_lambda_cgs = 1e-22

enable_fourier_bessel_perturbations = 0
perturbation_sigma = 0.01
perturbation_lmax = 12
perturbation_radial_modes = 16
perturbation_kmin = 1.0
perturbation_kmax = 16.0
perturbation_seed = 88172645463393265

enable_heating = magic
thermostat_temperature = 1.0e7
thermostat_Kp = 10.0
h_smooth_heatcool = 20.0
